{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hhadah/audit-responses-rating-app/blob/main/schema/study-bundle.schema.json",
  "title": "Audit response rating study bundle",
  "type": "object",
  "required": ["schema_version", "study", "items"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": { "type": "string", "minLength": 1 },
        "participant_prompt": { "type": "string", "minLength": 1 },
        "participant_help": { "type": "string", "minLength": 1 },
        "participant_placeholder": { "type": "string", "minLength": 1 },
        "item_term": { "type": "string", "minLength": 1 },
        "item_term_plural": { "type": "string", "minLength": 1 },
        "comparison_instructions": { "type": "string", "minLength": 1 },
        "left_heading": { "type": "string", "minLength": 1 },
        "right_heading": { "type": "string", "minLength": 1 },
        "rating_question": { "type": "string", "minLength": 1 },
        "reason_question": { "type": "string", "minLength": 1 },
        "reason_help": { "type": "string" },
        "require_reason_when_non_neutral": { "type": "boolean" },
        "other_reason_key": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "other_prompt": { "type": "string", "minLength": 1 },
        "completion_title": { "type": "string", "minLength": 1 },
        "completion_message": { "type": "string", "minLength": 1 },
        "accent_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "rating_scale": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "integer" },
              "label": { "type": "string", "minLength": 1 },
              "export_label": { "type": "string", "minLength": 1 }
            }
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label"],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "versions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "metadata": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": ["string", "number", "boolean", "null"]
            }
          },
          "versions": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "content"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "content": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
